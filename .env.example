# Copy this to .env.local for local `vercel dev` testing (never commit the real file).
# In production, set these in Vercel: Project Settings -> Environment Variables.
GMAIL_USER=info@startuplinkunimelb.net
GMAIL_APP_PASSWORD=

# Same two values as assets/js/config.js (Supabase -> Project Settings -> API).
# api/send-email.js uses them to check the caller is a signed-in committee member.
SUPABASE_URL=
SUPABASE_ANON_KEY=
