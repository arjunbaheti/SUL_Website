# Copy to .env.local for local development (never commit the real file).
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Email sender (app/api/send-email/route.ts)
GMAIL_USER=info@startuplinkunimelb.net
GMAIL_APP_PASSWORD=

# Used by the email route to check the caller is a signed-in committee member.
# Same values as Supabase -> Project Settings -> API (Project URL and the anon/publishable key).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: the browser falls back to the project's public values in lib/supabase.ts.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Protects /api/keepalive (the daily Supabase keep-awake ping) so only Vercel's cron can call it.
# Any long random string, e.g. from: openssl rand -hex 32
CRON_SECRET=
